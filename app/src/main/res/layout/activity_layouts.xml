<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aclayo_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_label_operation"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/aclayo_info_desc"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. ConstraintLayout solo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aclayo_section_const_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/aclayo_section_const_desc"
            android:textSize="11sp"
            android:textColor="#625B71" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="#EDE7F6"
            android:padding="8dp">

            <TextView
                android:id="@+id/boxA"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#FFB0BEC5"
                android:gravity="center"
                android:text="@string/aclayo_cell_a"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/boxB"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/boxB"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#FF90CAF9"
                android:gravity="center"
                android:text="@string/aclayo_cell_b"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/boxC"
                app:layout_constraintStart_toEndOf="@id/boxA"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/boxC"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#FFFFCC80"
                android:gravity="center"
                android:text="@string/aclayo_cell_c"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/boxB"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Linear vertical -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aclayo_section_linear_vert_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/aclayo_section_linear_vert_desc"
            android:textSize="11sp"
            android:textColor="#625B71" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#E8F5E9"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Botón 1"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:text="Botón 2" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:text="Botón 3"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>

        <!-- 3. Linear horizontal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aclayo_section_linear_horiz_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/aclayo_section_linear_horiz_desc"
            android:textSize="11sp"
            android:textColor="#625B71" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF3E0"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.chip.Chip
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chip A"
                style="@style/Widget.Material3.Chip.Filter" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chip B"
                style="@style/Widget.Material3.Chip.Filter" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chip C"
                style="@style/Widget.Material3.Chip.Filter" />
        </LinearLayout>

        <!-- 4. TableLayout -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aclayo_section_table_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/aclayo_section_table_desc"
            android:textSize="11sp"
            android:textColor="#625B71" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E3F2FD"
            android:padding="8dp"
            android:stretchColumns="1">

            <TableRow android:background="#BBDEFB"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aclayo_row_header1"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/aclayo_row_header2"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/aclayo_row_header3"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:padding="8dp">
                <TextView android:text="@string/aclayo_row_item1" />
                <TextView
                    android:gravity="center"
                    android:text="@string/aclayo_row_item2" />
                <TextView
                    android:gravity="end"
                    android:text="@string/aclayo_row_item3" />
            </TableRow>

            <TableRow android:padding="8dp">
                <TextView android:text="@string/aclayo_row_item4" />
                <TextView
                    android:gravity="center"
                    android:text="@string/aclayo_row_item5" />
                <TextView
                    android:gravity="end"
                    android:text="@string/aclayo_row_item6" />
            </TableRow>
        </TableLayout>

    </LinearLayout>
</ScrollView>
