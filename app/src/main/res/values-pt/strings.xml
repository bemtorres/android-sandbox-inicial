    <!-- ACINTR -->
    <string name="acintr_welcome">Bem-vindo ao Sandbox!</string>
    <string name="acintr_desc">Você completou login e cadastro. Agora explore cada widget a partir da Home. Cada card abre uma Activity de demonstração com validação, Toast/Dialog e Logcat.</string>
    <string name="acintr_user_placeholder">Olá, usuario@exemplo.com!</string>
    <string name="acintr_next_title">Próximo passo → Home Sandbox</string>
    <string name="acintr_info">Operação interna:\n• getIntent().getStringExtra() / SharedPreferences\n• TextView.setText()\n• Button onClick → startActivity(Intent → HomeActivity)\n• Log.i(TAG, \"intro exibido\")</string>

    <!-- ACHOME -->
    <string name="achome_title">Home — Sandbox de Widgets</string>
    <string name="achome_subtitle">Toque em um card para abrir seu laboratório</string>
    <string name="achome_arch_title">Arquitetura do Sandbox</string>
    <string name="achome_arch_desc">HomeActivity = Hub. Cada botão faz startActivity(Intent) para uma Activity isolada. Cada lab valida, mostra Toast/Dialog e escreve no Logcat. Assim você testa um widget sem quebrar os outros.</string>
    <string name="achome_card_inputs">1. TextInputs — TextView + EditText</string>
    <string name="achome_card_datetime">2. Date &amp; Time Pickers</string>
    <string name="achome_card_buttons">3. Button · ImageButton · Chip</string>
    <string name="achome_card_selection">4. CheckBox · RadioButton · Switch</string>
    <string name="achome_card_feedback">5. ProgressBar · RatingBar · Spinner</string>
    <string name="achome_card_webview">6. WebView</string>
    <string name="achome_card_dialogs">7. Dialog · Toast · Logger</string>
    <string name="achome_desc_inputs">plainText, password, numberPassword, email, phone, postalCode + TextWatcher + setError()</string>
    <string name="achome_desc_datetime">DatePickerDialog e TimePickerDialog com validação de data futura/passada</string>
    <string name="achome_desc_buttons">onClick, debouncing, ImageButton com contentDescription, ChipGroup</string>
    <string name="achome_desc_selection">Estados checked, RadioGroup, Switch com listener</string>
    <string name="achome_desc_feedback">Progress horizontal/indeterminado, RatingBar, Spinner com ArrayAdapter</string>
    <string name="achome_desc_webview">WebView + WebViewClient + permissão INTERNET</string>
    <string name="achome_desc_dialogs">AlertDialog, Date/Time dialogs, Snackbar simulado com Toast, Log.v/d/i/w/e</string>
    <string name="achome_tip">Dica: abra o Logcat, filtre por SANDBOX_* para ver cada laboratório.</string>
