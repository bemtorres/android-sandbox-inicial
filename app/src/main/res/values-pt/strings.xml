    <!-- ACMAIN -->
    <string name="acmain_title">Sandbox — Login</string>
    <string name="acmain_card_title">Como funciona internamente?</string>
    <string name="acmain_card_desc">1. EditText com inputType=textEmailAddress e textPassword.\n2. Ao pressionar Button → ValidationUtils.isEmail/isPassword → setError() se falhar.\n3. Toast + Log.d + SharedPreferences + Intent para RegisterActivity.</string>
    <string name="acmain_go_register">Não tem conta? Cadastre-se</string>
