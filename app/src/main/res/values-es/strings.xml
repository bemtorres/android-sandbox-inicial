    <string name="acregi_go_login">¿Ya tienes cuenta? Inicia sesión</string>

    <!-- ACINTR -->
    <string name="acintr_welcome">¡Bienvenido al Sandbox!</string>
    <string name="acintr_desc">Has completado login y registro. Ahora explora cada widget desde el Home. Cada tarjeta abre una Activity de demostración con validación, Toast/Dialog y Logcat.</string>
    <string name="acintr_user_placeholder">¡Hola, usuario@ejemplo.com!</string>
    <string name="acintr_next_title">Siguiente paso → Home Sandbox</string>
    <string name="acintr_info">Operación interna:\n• getIntent().getStringExtra() / SharedPreferences\n• TextView.setText()\n• Button onClick → startActivity(Intent → HomeActivity)\n• Log.i(TAG, \"intro mostrado\")</string>

    <!-- ACHOME -->
    <string name="achome_title">Home — Sandbox de Widgets</string>
    <string name="achome_subtitle">Toca una tarjeta para abrir su laboratorio</string>
    <string name="achome_arch_title">Arquitectura del Sandbox</string>
    <string name="achome_arch_desc">HomeActivity = Hub. Cada botón hace startActivity(Intent) a una Activity aislada. Cada lab valida, muestra Toast/Dialog y escribe en Logcat. Así pruebas un widget sin romper los demás.</string>
    <string name="achome_card_inputs">1. TextInputs — TextView + EditText</string>
    <string name="achome_card_datetime">2. Date &amp; Time Pickers</string>
    <string name="achome_card_buttons">3. Button · ImageButton · Chip</string>
    <string name="achome_card_selection">4. CheckBox · RadioButton · Switch</string>
    <string name="achome_card_feedback">5. ProgressBar · RatingBar · Spinner</string>
    <string name="achome_card_webview">6. WebView</string>
    <string name="achome_card_dialogs">7. Dialog · Toast · Logger</string>
    <string name="achome_desc_inputs">plainText, password, numberPassword, email, phone, postalCode + TextWatcher + setError()</string>
    <string name="achome_desc_datetime">DatePickerDialog y TimePickerDialog con validación de fecha futura/pasada</string>
    <string name="achome_desc_buttons">onClick, debouncing, ImageButton con contentDescription, ChipGroup</string>
    <string name="achome_desc_selection">Estados checked, RadioGroup, Switch con listener</string>
    <string name="achome_desc_feedback">Progress horizontal/indeterminado, RatingBar, Spinner con ArrayAdapter</string>
    <string name="achome_desc_webview">WebView + WebViewClient + permisos INTERNET</string>
    <string name="achome_desc_dialogs">AlertDialog, Date/Time dialogs, Snackbar simulado con Toast, Log.v/d/i/w/e</string>
    <string name="achome_tip">Tip: abre Logcat, filtra por SANDBOX_* para ver cada laboratorio.</string>
    <string name="achome_toast_opening">Abriendo %1$s</string>

