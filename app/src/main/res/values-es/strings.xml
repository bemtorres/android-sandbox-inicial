    <!-- ACMAIN -->
    <string name="acmain_title">Sandbox — Login</string>
    <string name="acmain_card_title">¿Cómo funciona internamente?</string>
    <string name="acmain_card_desc">1. EditText con inputType=textEmailAddress y textPassword.\n2. Al pulsar Button → ValidationUtils.isEmail/isPassword → setError() si falla.\n3. Toast + Log.d + SharedPreferences + Intent a RegisterActivity.</string>
    <string name="acmain_go_register">¿No tienes cuenta? Regístrate</string>
    <string name="acmain_logger_hint">Mira Logcat con tag \'SANDBOX_LOGIN\' para ver Logger (Log.v/d/i/w/e)</string>

