    <string name="acregi_go_login">Already have an account? Log in</string>

    <!-- ACINTR -->
    <string name="acintr_welcome">Welcome to the Sandbox!</string>
    <string name="acintr_desc">You have completed login and registration. Now explore each widget from Home. Each card opens a demo Activity with validation, Toast/Dialog and Logcat.</string>
    <string name="acintr_user_placeholder">Hello, user@example.com!</string>
    <string name="acintr_next_title">Next step → Home Sandbox</string>
    <string name="acintr_info">Internal operation:\n• getIntent().getStringExtra() / SharedPreferences\n• TextView.setText()\n• Button onClick → startActivity(Intent → HomeActivity)\n• Log.i(TAG, \"intro shown\")</string>

    <!-- ACHOME -->
    <string name="achome_title">Home — Widget Sandbox</string>
    <string name="achome_subtitle">Tap a card to open its lab</string>
    <string name="achome_arch_title">Sandbox Architecture</string>
    <string name="achome_arch_desc">HomeActivity = Hub. Each button does startActivity(Intent) to an isolated Activity. Each lab validates, shows Toast/Dialog and writes to Logcat. This way you test one widget without breaking others.</string>
    <string name="achome_card_inputs">1. TextInputs — TextView + EditText</string>
    <string name="achome_card_datetime">2. Date &amp; Time Pickers</string>
    <string name="achome_card_buttons">3. Button · ImageButton · Chip</string>
    <string name="achome_card_selection">4. CheckBox · RadioButton · Switch</string>
    <string name="achome_card_feedback">5. ProgressBar · RatingBar · Spinner</string>
    <string name="achome_card_webview">6. WebView</string>
    <string name="achome_card_dialogs">7. Dialog · Toast · Logger</string>
    <string name="achome_desc_inputs">plainText, password, numberPassword, email, phone, postalCode + TextWatcher + setError()</string>
    <string name="achome_desc_datetime">DatePickerDialog and TimePickerDialog with future/past date validation</string>
    <string name="achome_desc_buttons">onClick, debouncing, ImageButton with contentDescription, ChipGroup</string>
    <string name="achome_desc_selection">Checked states, RadioGroup, Switch with listener</string>
    <string name="achome_desc_feedback">Horizontal/indeterminate Progress, RatingBar, Spinner with ArrayAdapter</string>
    <string name="achome_desc_webview">WebView + WebViewClient + INTERNET permission</string>
    <string name="achome_desc_dialogs">AlertDialog, Date/Time dialogs, Snackbar simulated with Toast, Log.v/d/i/w/e</string>
    <string name="achome_tip">Tip: open Logcat, filter by SANDBOX_* to see each lab.</string>
    <string name="achome_toast_opening">Opening %1$s</string>

