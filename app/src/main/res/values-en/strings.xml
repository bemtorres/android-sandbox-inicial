    <!-- ACMAIN -->
    <string name="acmain_title">Sandbox — Login</string>
    <string name="acmain_card_title">How does it work internally?</string>
    <string name="acmain_card_desc">1. EditText with inputType=textEmailAddress and textPassword.\n2. On Button click → ValidationUtils.isEmail/isPassword → setError() on failure.\n3. Toast + Log.d + SharedPreferences + Intent to RegisterActivity.</string>
    <string name="acmain_go_register">Don\'t have an account? Sign up</string>
    <string name="acmain_btn_skip">Skip login → Intro</string>
    <string name="acmain_logger_hint">Check Logcat with tag \'SANDBOX_LOGIN\' to see Logger (Log.v/d/i/w/e)</string>

