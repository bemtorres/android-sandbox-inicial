    <string name="aclayo_title">Lab 8 — Layouts</string>
    <string name="aclayo_info_desc">• ConstraintLayout: single flat plane, constraints top/start/end/bottom, no nesting, best performance\n• Vertical LinearLayout: orientation vertical, weight to distribute\n• Horizontal LinearLayout: orientation horizontal, weight and gravity\n• TableLayout: TableRow, stretchColumns, shrinkColumns</string>
    <string name="aclayo_section_const_title">ConstraintLayout — flat</string>
    <string name="aclayo_section_const_desc">4 TextViews with constraints to parent and each other. No nested Linear. Recommended for complex screens.</string>
    <string name="aclayo_section_linear_vert_title">Vertical LinearLayout</string>
    <string name="aclayo_section_linear_vert_desc">orientation="vertical", 3 buttons distributed with layout_weight="1".</string>
    <string name="aclayo_section_linear_horiz_title">Horizontal LinearLayout</string>
    <string name="aclayo_section_linear_horiz_desc">orientation="horizontal", 3 chips/icons in a row with weight, gravity center.</string>
    <string name="aclayo_section_table_title">TableLayout</string>
    <string name="aclayo_section_table_desc">TableLayout with stretchColumns="1", 3 rows (header + 2 data) with TableRow.</string>
